<group name="windows, execution, lolbas,">
  <rule id="100140" level="12">
    <if_sid>61603</if_sid> <!-- Sysmon Event 1 -->
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)certutil\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-urlcache</field>
    <description>LOLBAS: Certutil used for remote file download</description>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

  <rule id="100141" level="12">
    <if_sid>61603</if_sid>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)bitsadmin\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/transfer</field>
    <description>LOLBAS: Bitsadmin used for remote file download</description>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

  <rule id="100142" level="10">
    <if_sid>61603</if_sid>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)mshta\.exe$</field>
    <description>LOLBAS: Mshta execution detected</description>
    <mitre>
      <id>T1218.005</id>
    </mitre>
  </rule>
</group>
