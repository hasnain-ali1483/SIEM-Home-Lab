<group name="windows, persistence, registry,">
  <rule id="100160" level="10">
    <if_sid>61614</if_sid> <!-- Sysmon Event 12, 13, 14 base -->
    <field name="win.system.eventID">^13$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)(SOFTWARE\Microsoft\Windows\CurrentVersion\Run|SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce)</field>
    <description>Persistence: Registry Run or RunOnce key modified</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>
</group>
