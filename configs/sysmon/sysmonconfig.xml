<Sysmon schemaversion="4.90">
  <!-- Hash algorithms used for file hashing -->
  <HashAlgorithms>MD5,SHA256,IMPHASH</HashAlgorithms>

  <EventFiltering>
    <!-- Event ID 1: ProcessCreate - Log all process creations -->
    <RuleGroup name="" groupRelation="or">
      <ProcessCreate onmatch="include">
        <Rule name="IncludeAllProcesses" groupRelation="and">
          <!-- Log all processes to capture full command line and hashes -->
        </Rule>
      </ProcessCreate>
    </RuleGroup>
    
    <!-- Exclude noisy processes from Event ID 1 -->
    <RuleGroup name="" groupRelation="or">
      <ProcessCreate onmatch="exclude">
        <!-- Exclude background noise like svchost -->
        <Image condition="end with">svchost.exe</Image>
        <Image condition="end with">conhost.exe</Image>
        <Image condition="end with">MsMpEng.exe</Image>
      </ProcessCreate>
    </RuleGroup>

    <!-- Event ID 3: NetworkConnect - Log network connections -->
    <RuleGroup name="" groupRelation="or">
      <NetworkConnect onmatch="include">
        <!-- Include common outgoing connections -->
        <DestinationPort condition="is">80</DestinationPort>
        <DestinationPort condition="is">443</DestinationPort>
        <DestinationPort condition="is">445</DestinationPort>
        <DestinationPort condition="is">3389</DestinationPort>
      </NetworkConnect>
    </RuleGroup>

    <RuleGroup name="" groupRelation="or">
      <NetworkConnect onmatch="exclude">
        <!-- Exclude known Microsoft IPs / svchost to reduce noise -->
        <Image condition="end with">svchost.exe</Image>
        <Image condition="end with">MsMpEng.exe</Image>
        <Image condition="end with">spoolsv.exe</Image>
      </NetworkConnect>
    </RuleGroup>

    <!-- Event ID 7: ImageLoad - Monitor DLL loads -->
    <RuleGroup name="" groupRelation="or">
      <ImageLoad onmatch="include">
        <!-- Focus on unsigned DLLs which are highly suspicious -->
        <SignatureStatus condition="is">Unsigned</SignatureStatus>
      </ImageLoad>
    </RuleGroup>

    <!-- Event ID 8: CreateRemoteThread - Critical for process injection -->
    <RuleGroup name="" groupRelation="or">
      <CreateRemoteThread onmatch="include">
        <!-- Monitor injection into critical system processes -->
        <TargetImage condition="end with">lsass.exe</TargetImage>
        <TargetImage condition="end with">svchost.exe</TargetImage>
        <TargetImage condition="end with">explorer.exe</TargetImage>
        <TargetImage condition="end with">cmd.exe</TargetImage>
        <TargetImage condition="end with">powershell.exe</TargetImage>
      </CreateRemoteThread>
    </RuleGroup>

    <!-- Event ID 10: ProcessAccess - Monitor access to lsass.exe -->
    <RuleGroup name="" groupRelation="or">
      <ProcessAccess onmatch="include">
        <!-- Monitor credential dumping attempts against lsass -->
        <TargetImage condition="end with">lsass.exe</TargetImage>
      </ProcessAccess>
    </RuleGroup>

    <!-- Event ID 11: FileCreate - Monitor executable/script creation -->
    <RuleGroup name="" groupRelation="or">
      <FileCreate onmatch="include">
        <!-- Target executables and scripts dropped to disk -->
        <TargetFilename condition="end with">.exe</TargetFilename>
        <TargetFilename condition="end with">.dll</TargetFilename>
        <TargetFilename condition="end with">.ps1</TargetFilename>
        <TargetFilename condition="end with">.bat</TargetFilename>
        <TargetFilename condition="end with">.vbs</TargetFilename>
        <TargetFilename condition="end with">.hta</TargetFilename>
      </FileCreate>
    </RuleGroup>

    <RuleGroup name="" groupRelation="or">
      <FileCreate onmatch="exclude">
        <!-- Exclude standard system directories to reduce update noise -->
        <TargetFilename condition="contains">\Windows\System32\</TargetFilename>
        <TargetFilename condition="contains">\Windows\SysWOW64\</TargetFilename>
      </FileCreate>
    </RuleGroup>

    <!-- Event ID 12/13/14: RegistryEvent - Persistence mechanisms -->
    <RuleGroup name="" groupRelation="or">
      <RegistryEvent onmatch="include">
        <!-- Monitor Run keys -->
        <TargetObject condition="contains">\CurrentVersion\Run</TargetObject>
        <TargetObject condition="contains">\CurrentVersion\RunOnce</TargetObject>
        <!-- Monitor Services -->
        <TargetObject condition="contains">\Services\</TargetObject>
        <!-- Monitor Scheduled Tasks -->
        <TargetObject condition="contains">\\ScheduledTasks\\</TargetObject>
      </RegistryEvent>
    </RuleGroup>

    <!-- Event ID 22: DNSQuery - Log DNS queries -->
    <RuleGroup name="" groupRelation="or">
      <DnsQuery onmatch="exclude">
        <!-- Exclude common Windows telemetry and update domains -->
        <QueryName condition="end with">.microsoft.com</QueryName>
        <QueryName condition="end with">.windowsupdate.com</QueryName>
        <QueryName condition="end with">.msn.com</QueryName>
        <QueryName condition="end with">.bing.com</QueryName>
        <QueryName condition="end with">.skype.com</QueryName>
      </DnsQuery>
    </RuleGroup>

    <RuleGroup name="" groupRelation="or">
      <DnsQuery onmatch="include">
        <QueryName condition="contains">.</QueryName>
      </DnsQuery>
    </RuleGroup>

  </EventFiltering>
</Sysmon>
